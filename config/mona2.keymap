#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        Lcrick {
            bindings = <&mkp MB1>;
            key-positions = <18 17>;
        };

        Rcrick {
            bindings = <&mkp MB2>;
            key-positions = <18 19>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <10 11>;
        };

        F1combo {
            bindings = <&kp F1>;
            key-positions = <12 14>;
        };

        F2combo {
            bindings = <&kp F2>;
            key-positions = <12 25>;
        };

        Pcombo {
            bindings = <&kp P>;
            key-positions = <8 20>;
        };

        qcombo {
            bindings = <&kp Q>;
            key-positions = <1 10>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB           &kp W       &kp E         &kp R  &kp T                                &kp Y        &kp U  &kp I      &kp O    &kp BACKSPACE
&kp A             &kp S       &kp D         &kp F  &kp G                     &kp MINUS  &kp H        &kp J  &kp K      &kp L    &kp ENTER
&mt LEFT_SHIFT Z  &kp X       &kp C         &kp V  &kp B        &kp COLON    &kp SLASH  &kp N        &kp M  &kp COMMA  &kp DOT  &kp P
&kp LCTRL         &kp LSHIFT  &kp LEFT_ALT  &mo 7  &lt 2 ENTER  &mo 1        &mo 2      &lt 3 ENTER                             &kp LC(SPACE)
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp F1          &kp F2  &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7  &kp F8  &kp F11         &kp F12
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &kp F9          &kp F10
&kp LCTRL       &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &kp LEFT_ARROW  &kp RIGHT
&trans          &trans  &trans  &trans  &trans  &trans    &trans  &trans                                  &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp POUND          &kp DOLLAR  &kp PERCENT                                     &kp CARET              &kp AMPERSAND  &kp MINUS     &kp F11    &kp F12
&kp GRAVE        &kp TILDE    &kp DOUBLE_QUOTES  &kp SQT     &trans                    &kp MINUS             &kp EXCLAMATION        &kp AT_SIGN    &kp HASH      &kp EQUAL  &kp PAGE_UP
&trans           &trans       &trans             &trans      &trans       &kp UNDER    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp QUESTION   &kp QUESTION  &mo 4      &kp PAGE_DOWN
&trans           &trans       &trans             &trans      &trans       &trans       &trans                &trans                                                         &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&trans  &kp LC(LS(TAB))     &kp PRINTSCREEN         &kp LC(TAB)              &trans                                     &kp N7        &kp N8        &kp N9        &kp DELETE  &kp BACKSPACE
&trans  &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)     &kp LC(LG(LEFT_ARROW))   &kp LC(LG(RIGHT_ARROW))            &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS   &kp PAGE_UP
&trans  &kp LEFT_SHIFT      &kp LG(LS(LEFT_ARROW))  &kp LG(LS(RIGHT_ARROW))  &trans                   &trans    &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0      &kp PAGE_DOWN
&trans  &trans              &trans                  &trans                   &trans                   &trans    &trans  &trans                                                &kp LG(NUMBER_1)
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_4 {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                  &trans       &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans    &bootloader  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans    &trans       &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans            &trans  &trans  &mkp MB1  &mkp MB2  &mo 6   &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans                              &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_7 {
            bindings = <
&kp ESCAPE      &kp EXCLAMATION  &kp QUESTION  &trans  &trans                    &kp N7        &kp N8        &kp N9        &kp AT_SIGN     &kp BACKSPACE
&kp LEFT_SHIFT  &trans           &trans        &trans  &trans            &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS       &kp UP_ARROW
&kp TAB         &trans           &kp LEFT_WIN  &trans  &trans  &trans    &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LEFT_ARROW  &kp RIGHT
&kp LCTRL       &trans           &trans        &trans  &trans  &trans    &trans  &kp N0                                                    &kp DOWN_ARROW
            >;
        };
    };
};
